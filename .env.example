PORT=5000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
PUBLIC_BASE_URL=http://localhost:5000

# Multi-deployment isolation — only matters once you're running more than one deployment of this
# repo on the SAME VPS (e.g. one per hospital, each in its own /var/www/<name> directory — see
# DEPLOYMENT.md's "Deploying Additional Hospitals on the Same VPS" section). Leave every one of
# these commented out / at its default for a single, standalone deployment; nothing below needs
# touching. For a second+ deployment sharing a VPS, give EACH one a unique COMPOSE_PROJECT_NAME
# (this is what actually keeps their containers/networks/volumes/image tags from colliding) and a
# unique *_HOST_PORT for each service below, so their published ports don't collide either.
# COMPOSE_PROJECT_NAME=maa-multicare-hospital
# API_HOST_PORT=5000
# MONGO_HOST_PORT=27017
# REDIS_HOST_PORT=6379
# FLOWER_HOST_PORT=5555

# MongoDB
# Local dev default (no auth) — this works as-is against the plain `mongo` container from
# docker-compose.yml when you're running the app directly on the host with `--reload`.
# For a VPS/production deployment where the app itself also runs inside Docker (see
# DEPLOYMENT.md's self-hosted MongoDB section), this instead needs to be a full auth URI
# pointing at the "mongo" service by container name, e.g.:
#   MONGODB_URI=mongodb://<app-user>:<app-password>@mongo:27017/<MONGODB_DB_NAME value>?authSource=<MONGODB_DB_NAME value>
MONGODB_URI=mongodb://127.0.0.1:27017
# Give this an actual hospital-specific name in production (e.g. "maa_multicare_hospital") —
# especially important once you're running more than one hospital's backend: each deployment's
# own self-hosted Mongo container is already fully isolated from the others regardless of this
# name, but a distinct name still makes backups, mongodump output, and `mongosh` sessions
# unambiguous about which hospital's data you're looking at. Mongo database names can't contain
# spaces or most punctuation — stick to lowercase letters, numbers, and underscores.
MONGODB_DB_NAME=ai_calling_agent

# Daily backup script (scripts/backup_mongo.sh, see DEPLOYMENT.md Step 3.5.5) — both optional,
# sensible defaults shown here as comments. BACKUP_DIR defaults to a name derived from
# MONGODB_DB_NAME above if not set, so on a shared VPS with multiple hospitals each one's backups
# already land in their own separate directory without needing this set explicitly.
# BACKUP_DIR=/var/backups/ai_calling_agent-mongo
# BACKUP_RETENTION_DAYS=14

# Self-hosted Mongo container's root/admin account — only used once, to bootstrap the container
# and to create the app-specific user above; the running app never uses these credentials
# directly. Not needed at all if MONGODB_URI above points at a managed service (e.g. Atlas)
# instead of the "mongo" container. Generate with: openssl rand -hex 20
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# Admin JWT auth
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Shared secret required in the X-Tool-Secret header on every agent_tools call — must match the
# header value you paste into each Custom Function's config in the Edesy dashboard
AGENT_TOOL_SECRET=change-me-to-a-long-random-string

# Edesy AI Voice Agent (voice-agent.edesy.in) — calling is fully delegated to this hosted service
EDESY_BASE_URL=https://voice-agent.edesy.in
EDESY_API_KEY=
EDESY_WEBHOOK_SECRET=
EDESY_AGENT_ID=
# Strongly recommended — the hospital's actual purchased phone number (E.164, e.g.
# +919876543210), NOT Edesy's free trial number. Every outbound call is placed FROM this number
# explicitly. Optional: if left unset, calls still go out (Edesy falls back to its own
# account-level default number instead of the queue refusing to dispatch) — but see config.py's
# edesy_from_number docstring for why that fallback was observed to resolve to the wrong number.
EDESY_FROM_NUMBER=

# Google Calendar — a one-way, OUTBOUND-ONLY mirror of appointments onto a single dedicated
# calendar, purely for the doctor's own visibility (see services/google_calendar_sync_service.py).
# Patients can NEVER book/reschedule/cancel through Google Calendar directly — only via the Edesy
# AI phone system above. No inbound sync, no webhooks. Auth is a Google Cloud Service Account —
# works with a 100% free personal Gmail account, no Google Workspace needed. Setup: create a GCP
# project -> enable the Calendar API -> create a Service Account -> download its JSON key -> in
# your Gmail, create a NEW secondary calendar (not your primary one) -> share it with the service
# account's "client_email", permission "Make changes to events".
GOOGLE_SERVICE_ACCOUNT_JSON=
# The dedicated secondary calendar's own ID (its Settings page, under "Integrate calendar") —
# looks like "xxxxxxxxxxxxxxxxxxxxxxxxxxxx@group.calendar.google.com".
GOOGLE_CALENDAR_ID=
# Plain text shown in each event's `location` field (e.g. the hospital's physical address).
GOOGLE_CALENDAR_EVENT_LOCATION=
# GOOGLE_CALENDAR_DEFAULT_EVENT_DURATION_MINUTES=30
# GOOGLE_CALENDAR_PUSH_POLL_INTERVAL_SECONDS=30

# Meta WhatsApp Business Platform — a second, independent one-way OUTBOUND-ONLY notification
# channel: patients get an automatic WhatsApp message on book/reschedule/cancel (see
# services/whatsapp_notification_service.py). This is NOT a chatbot — any reply a patient sends is
# logged and ignored; it never reaches this system's booking logic, only the clinic's own WhatsApp
# Business app. Setup: create/use a Meta Business Portfolio at business.facebook.com -> create an
# App at developers.facebook.com/apps, add the WhatsApp product -> WhatsApp > API Setup gives the
# phone number ID -> Business Settings > Users > System Users: create one, assign the WhatsApp
# Business Account with Full Control, generate a non-expiring token with
# whatsapp_business_messaging + whatsapp_business_management permissions -> App Dashboard >
# Settings > Basic has the App Secret -> WhatsApp > Configuration > Webhook: callback URL =
# <PUBLIC_BASE_URL>/api/v1/webhooks/whatsapp, verify token = any string you choose, then subscribe
# to the "messages" field -> create 3 Utility-category message templates (appointment_booked_v1,
# appointment_rescheduled_v1, appointment_cancelled_v1) in WhatsApp Manager and wait for APPROVED
# status before enabling this.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Must exactly match the language the 3 templates above were approved in.
# META_WHATSAPP_TEMPLATE_LANGUAGE_CODE=en_US
# Kill switch — set false to pause all outbound WhatsApp sends without a redeploy.
# META_WHATSAPP_NOTIFICATIONS_ENABLED=true
# META_WHATSAPP_PUSH_POLL_INTERVAL_SECONDS=30

# Redis / Celery — drives the call_schedules outbound queue worker
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# Dev-only fallback if Redis/Celery aren't available — see workers/inprocess_scheduler.py
ENABLE_INPROCESS_SCHEDULER=false

# call_schedules queue tuning — the stuck-sweep interval itself is fixed at 10 min in
# workers/scheduler.py, not configurable via env. A call that fails or goes unanswered is marked
# "missed" and is NOT retried automatically.
OUTBOUND_CALL_POLL_INTERVAL_SECONDS=30
